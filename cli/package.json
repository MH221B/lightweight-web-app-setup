{
  "name": "lwapp",
  "version": "0.2.0",
  "description": "Scaffold a React or Angular Bun monorepo from the lightweight web app starter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MH221B/lightweight-web-app-setup.git",
    "directory": "cli"
  },
  "bin": {
    "lwapp": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "overlays"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outfile dist/index.js --external @inquirer/prompts",
    "templates:sync": "bun scripts/sync-templates.ts",
    "start": "node dist/index.js",
    "test": "bun run templates:sync && bun run build && bun test test",
    "prepare": "bun run templates:sync && bun run build"
  },
  "dependencies": {
    "@inquirer/prompts": "8.8.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
