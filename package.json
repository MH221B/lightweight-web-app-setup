{
  "name": "lightweight-web-app-starter",
  "private": true,
  "workspaces": [
    "client",
    "client-angular",
    "server",
    "shared",
    "cli"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:client dev:server",
    "dev:client": "bun run --filter client dev",
    "dev:angular": "bun run --parallel dev:angular-client dev:angular-server",
    "dev:angular-client": "bun run --filter client-angular start",
    "dev:angular-server": "bun run --filter server dev",
    "dev:server": "bun run --filter server dev",
    "routes": "bun run --filter client routes",
    "build": "bun run --filter client build && bun run --filter client-angular build",
    "typecheck": "bun run routes && vp check --no-fmt --no-lint",
    "check": "bun run routes && vp check && bun run --filter client-angular lint",
    "verify": "bun run check && bun run test && bun run build",
    "test": "bun run --filter server test && bun run test:cli",
    "test:cli": "bun run --filter mh-stack templates:sync && bun run --filter mh-stack build && bun test cli/test",
    "templates:sync": "bun run --filter mh-stack templates:sync",
    "db:generate": "bun run --filter server db:generate",
    "db:generate:pg": "bun run --filter server db:generate:pg",
    "db:migrate": "bun run --filter server db:migrate",
    "start": "bun run --filter server start"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.8"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.7.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
